+#[derive(Default)]
+pub(super) struct RegistrationObservation {active:AtomicUsize,peak:AtomicUsize,calls:AtomicUsize}
+pub(super) struct RegistrationSpan(Arc<RegistrationObservation>);
+impl RegistrationSpan {
+    pub(super) fn begin(observer:Arc<RegistrationObservation>)->Self {
+        observer.calls.fetch_add(1,Ordering::SeqCst);
+        let active=observer.active.fetch_add(1,Ordering::SeqCst)+1;
+        observer.peak.fetch_max(active,Ordering::SeqCst);Self(observer)
+    }
+}
+impl Drop for RegistrationSpan {fn drop(&mut self) {self.0.active.fetch_sub(1,Ordering::SeqCst);}}
+
+#[derive(Clone,Copy,Debug,PartialEq,Eq,Serialize)]
+pub enum PhaseStatus { Ready, Adding, NeedsBalance, Balancing, NeedsReshard, Resharding }
+pub(super) struct Phases {
+    status:PhaseStatus,
+    remaining:usize,
+    workers:usize,
+    completed:usize,
+    registered:usize,
+    worker_jobs:usize,
+    peak_outstanding:usize,
+    reservations:Vec<Value>,
+    registration:Arc<RegistrationObservation>,
+}
+impl AuthoritativeTree {
+    pub fn enable_construction_phases(&mut self, owner_registration_workers:usize) -> Result<()> {
+        self.usable()?;
+        ensure!(self.dynamic_mode && self.limits.max_nodes<=10000 && self.phase.is_none() && (1..=8).contains(&owner_registration_workers),"phase activation differs");
+        let registration=Arc::new(RegistrationObservation::default());
+        self.poisoned=true;
+        for owner in self.owners.keys().copied().collect::<Vec<_>>() {ensure!(matches!(self.structural(owner,OwnerCommand::SetRegistrationObservation(registration.clone()))?,OwnerReply::Ack),"phase registration observer reply");}
+        self.poisoned=false;
+        self.phase=Some(Phases {status:PhaseStatus::Ready,remaining:0,workers:owner_registration_workers,completed:0,registered:0,worker_jobs:0,peak_outstanding:0,reservations:vec![],registration});
+        Ok(())
+    }
+    pub fn construction_phase_report(&self) -> Value {
+        self.phase.as_ref().map(|p|json!({"valid":p.registration.active.load(Ordering::SeqCst)==0,"poisoned":self.poisoned,"status":p.status,"remaining_rows":p.remaining,"configured_owner_workers":p.workers,"completed_phases":p.completed,"registered_rows":p.registered,"worker_jobs":p.worker_jobs,"peak_outstanding_owner_requests":p.peak_outstanding,"peak_active_owner_registrations":p.registration.peak.load(Ordering::SeqCst),"active_owner_registrations":p.registration.active.load(Ordering::SeqCst),"owner_registration_calls":p.registration.calls.load(Ordering::SeqCst),"reservations":p.reservations,"balance_round_limit_hits":self.event_counts.get("balance-round-limit").copied().unwrap_or(0),"balance_execution":"serialized existing global semantics","parallel_scope":"owner registration only; central routing serial; active registration spans include vector I/O waits and are not CPU utilization"})).unwrap_or(Value::Null)
+    }
+    /// Conservatively reserve the whole phase at every possible destination.
+    /// The extra physical-row allowance is explicit, not a proof against arbitrary
+    /// repeated reassignment. Existing per-registration hard limits remain active.
+    pub fn reserve_construction_phase(&mut self, rows:usize, balance_headroom_rows:usize) -> Result<()> {
+        self.usable()?;
+        self.phase_require_ready()?;
+        let p=self.phase.as_ref().context("phases not enabled")?;
+        ensure!(p.reservations.len()<32,"phase report cap");
+        ensure!(rows>0 && balance_headroom_rows>=rows && self.locations.len().checked_add(rows).is_some_and(|n|n<=self.limits.max_vectors),"phase reservation range/headroom");
