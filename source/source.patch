+        self.phase.as_mut().unwrap().status=PhaseStatus::Balancing;
+        self.balance_dynamic_current()?;
+        self.phase.as_mut().unwrap().status=PhaseStatus::NeedsReshard;
+        Ok(())
+    }
+    pub fn reshard_construction_phase(&mut self) -> Result<()> {
+        self.usable()?;
