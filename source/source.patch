+                let mut results=vec![];
+                for (sender,rows) in work {for (index,leaf,id) in rows {
+                    let n=active.fetch_add(1,Ordering::SeqCst)+1;high.fetch_max(n,Ordering::SeqCst);
+                    let reply=exchange(&sender,Command::RegisterNew(leaf,id,VectorRef {root,key:id}));
