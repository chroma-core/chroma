+                TreeNode::Internal(parent) => (true, parent.parent_id),
+                TreeNode::Leaf(leaf) => (false, leaf.parent_id),
+            },
+            None => return,
+        };
+        if internal {
+            self.publish_child_navigation(node_id);
+        }
+        if let Some(parent_id) = parent_id {
+            self.publish_child_navigation(parent_id);
+        }
+    }
