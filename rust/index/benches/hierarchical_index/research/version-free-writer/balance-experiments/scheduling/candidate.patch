+    /// Balance eligible leaves through a shared queue, joining between rounds.
     pub fn balance_index_parallel(&mut self, num_threads: usize) -> Result<(), String> {
         self.ensure_healthy()?;
         let _mutation = MutationGuard(&self.poisoned);
