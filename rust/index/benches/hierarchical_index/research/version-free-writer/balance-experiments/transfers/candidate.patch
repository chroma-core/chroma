+
+fn parallel_chunks<T: Sync, U: Send>(
+    input: &[T],
+    threads: usize,
+    work: impl Fn(&T) -> U + Sync,
+) -> Vec<U> {
+    let chunk = input.len().div_ceil(threads.max(1)).max(1);
+    std::thread::scope(|scope| {
+        let work = &work;
+        let handles: Vec<_> = input
+            .chunks(chunk)
+            .map(|items| scope.spawn(move || items.iter().map(work).collect::<Vec<_>>()))
+            .collect();
+        handles
+            .into_iter()
+            .flat_map(|handle| handle.join().unwrap())
+            .collect()
+    })
+}
