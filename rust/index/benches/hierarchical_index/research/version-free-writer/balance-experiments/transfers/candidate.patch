+/// Reset the round flag even when a structural worker unwinds.
+struct DeferredTransferGuard<'a>(&'a AtomicBool);
+impl Drop for DeferredTransferGuard<'_> {
+    fn drop(&mut self) {
+        self.0.store(false, Ordering::Release);
+    }
+}
