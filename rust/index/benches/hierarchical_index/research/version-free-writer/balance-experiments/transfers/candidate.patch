+    /// Structural workers have joined before this phase starts. Sources prepare
+    /// disjoint outgoing rows against one stable tree; each changed leaf then
+    /// receives one combined replacement containing its survivors and arrivals.
+    fn apply_transfer_batch(
+        &self,
+        pending: Vec<Reassignment>,
+        threads: usize,
+        timing: &mut BalanceIterationTiming,
+    ) {
+        if pending.is_empty() {
+            return;
+        }
+        let _mutation = MutationGuard(&self.poisoned);
+        let mut by_source: HashMap<NodeId, Vec<Reassignment>> = HashMap::new();
+        let mut retiring = HashSet::new();
+        for work in pending {
+            if work.excluded == Some(work.source) {
+                retiring.insert(work.source);
+            }
+            by_source.entry(work.source).or_default().push(work);
+        }
+        // A batch must retain a destination when every leaf requests evacuation.
+        // Prefer the largest non-evacuating leaf; otherwise keep the largest
+        // evacuation source. Node ID resolves equal sizes deterministically.
+        let sink = self
+            .nodes
+            .iter()
+            .filter_map(|node| {
+                let TreeNode::Leaf(leaf) = node.value() else {
+                    return None;
+                };
+                Some((
+                    !retiring.contains(node.key()),
+                    leaf.length,
+                    std::cmp::Reverse(*node.key()),
+                ))
+            })
+            .max()
+            .map(|(_, _, std::cmp::Reverse(id))| id);
+        if let Some(sink) = sink {
+            retiring.remove(&sink);
+        }
+        let groups: Vec<_> = by_source.into_iter().collect();
+        let prepared = parallel_chunks(&groups, threads, |(source, work)| {
+            self.prepare_transfer_source(*source, work, &retiring, sink)
+        });
+        let mut replacements: HashMap<NodeId, PostingRows> = HashMap::new();
+        let mut incoming: HashMap<NodeId, PostingRows> = HashMap::new();
+        let mut retire = Vec::new();
+        let mut retries = Vec::new();
+        let mut moved = 0;
+        for source in prepared {
+            timing.retry_coalesced_ids += source.coalesced;
+            timing.retry_current_ids += source.current;
+            if let Some(rows) = source.remaining {
+                replacements.insert(source.source, rows);
+                self.stats.transfer_batches.fetch_add(1, Ordering::Relaxed);
+            }
+            for (destination, mut rows) in source.outgoing {
+                moved += rows.ids.len();
+                let target = incoming.entry(destination).or_default();
+                target.ids.append(&mut rows.ids);
+                target.codes.append(&mut rows.codes);
+            }
+            retries.extend(source.retries);
+            if source.retire {
+                retire.push(source.source);
+            }
+        }
+        timing.retry_superseded_ids = timing.retry_coalesced_ids - timing.retry_current_ids;
+        for (destination, mut arrivals) in incoming {
+            let rows = replacements.entry(destination).or_insert_with(|| {
+                self.load_posting_sync(destination);
+                let node = self
+                    .nodes
+                    .get(&destination)
+                    .expect("stable destination disappeared");
+                let TreeNode::Leaf(leaf) = node.value() else {
+                    panic!("stable destination changed type");
+                };
+                PostingRows {
+                    ids: leaf.ids.clone(),
+                    codes: leaf.codes.clone(),
+                }
+            });
+            rows.ids.append(&mut arrivals.ids);
+            rows.codes.append(&mut arrivals.codes);
+        }
+        // Posting buffers, lazy reads, and dirty marks finish before publication.
+        // A leaf that both sends and receives rows has one final replacement.
+        let updates: Vec<_> = replacements.into_iter().collect();
+        for (id, rows) in &updates {
+            assert_eq!(rows.codes.len(), rows.ids.len() * self.code_size());
+            self.mark_node_dirty(*id);
+        }
+        self.pending_transfers.lock().extend(retries);
+        let updates: Vec<_> = updates.into_iter().map(Mutex::new).collect();
+        parallel_chunks(&updates, threads, |update| {
+            let (id, rows) = std::mem::take(&mut *update.lock());
+            let mut node = self.nodes.get_mut(&id).expect("stable leaf disappeared");
+            let TreeNode::Leaf(leaf) = node.value_mut() else {
+                panic!("stable leaf changed type");
+            };
+            leaf.ids = rows.ids;
+            leaf.codes = rows.codes;
+            leaf.length = leaf.ids.len();
+            drop(node);
+            #[cfg(test)]
+            if self
+                .fail_transfer_after_append
+                .swap(false, Ordering::Relaxed)
+            {
+                panic!("injected transfer failure during batch publication");
+            }
+        });
+        self.stats
+            .transferred_vectors
+            .fetch_add(moved as u64, Ordering::Relaxed);
+        for source in retire {
+            // Final emptiness includes incoming rows. Never retire an arrival.
+            if !self.retire_empty_leaf(source) {
+                self.pending_transfers.lock().push(Reassignment {
+                    source,
+                    ids: Vec::new(),
+                    excluded: Some(source),
+                });
+            }
+        }
+    }
+
+    fn prepare_transfer_source(
+        &self,
+        source: NodeId,
+        work: &[Reassignment],
+        retiring: &HashSet<NodeId>,
+        sink: Option<NodeId>,
+    ) -> PreparedSource {
+        let start = Instant::now();
+        let mut proposed: HashMap<u32, HashSet<NodeId>> = HashMap::new();
+        let retire = work.iter().any(|work| work.excluded == Some(source));
+        for group in work {
+            for &id in &group.ids {
+                // Union exclusions from overlapping proposals. Excluding this
+                // source forces evacuation even if an ordinary proposal exists.
+                proposed.entry(id).or_default().extend(group.excluded);
+            }
+        }
+        let mut result = PreparedSource {
+            source,
+            remaining: None,
+            outgoing: HashMap::new(),
+            retries: Vec::new(),
+            retire,
+            coalesced: proposed.len(),
+            current: 0,
+        };
+        self.load_posting_sync(source);
+        let (ids, codes, centroid) = {
+            let Some(node) = self.nodes.get(&source) else {
+                return result;
+            };
+            let TreeNode::Leaf(leaf) = node.value() else {
+                return result;
+            };
+            (leaf.ids.clone(), leaf.codes.clone(), leaf.centroid.clone())
+        };
+        let current: Vec<_> = ids
+            .iter()
+            .filter(|id| proposed.contains_key(id))
+            .copied()
+            .collect();
+        result.current = current.len();
+        self.load_embeddings_sync(&current);
+        self.stats
+            .reassigns
+            .fetch_add(current.len() as u64, Ordering::Relaxed);
+        let source_query = (!self.config.fp_npa).then(|| {
+            let norm = Self::vec_norm(&centroid);
+            QuantizedQuery::new(
+                &vec![0.0; self.dim],
+                self.padded_bytes(),
+                norm,
+                norm * norm,
+                norm,
+            )
+        });
+        let mut targets: HashMap<NodeId, PreparedTransfer> = HashMap::new();
+        let mut remaining = PostingRows {
+            ids: Vec::with_capacity(ids.len()),
+            codes: Vec::with_capacity(codes.len()),
+        };
+        let mut accepted = 0;
+        for (slot, &id) in ids.iter().enumerate() {
+            let code = code_slice(&codes, slot, self.code_size());
+            let mut moved = false;
+            if let Some(exclusions) = proposed.get(&id) {
+                let forced = exclusions.contains(&source);
+                let excluded = if forced {
+                    Some(source)
+                } else {
+                    exclusions.iter().copied().min()
+                };
+                // The retained sink supplies a destination for other evacuating
+                // leaves and keeps its own forced rows for this batch.
+                if !(forced && sink == Some(source)) {
+                    let embedding = self
+                        .embeddings
+                        .get(&id)
+                        .expect("missing immutable embedding");
+                    let candidates = self.navigate_f32_excluding(
+                        &embedding,
+                        &self.write_beam_policy(),
+                        excluded,
+                    );
+                    let destination = candidates
+                        .iter()
+                        .find(|(id, _)| !retiring.contains(id) && !exclusions.contains(id))
+                        .map(|(id, _)| *id)
+                        .or_else(|| {
+                            forced
+                                .then_some(sink)
+                                .flatten()
+                                .filter(|id| *id != source && !exclusions.contains(id))
+                        });
+                    if let Some(destination) = destination {
+                        if destination != source {
+                            let target = targets.entry(destination).or_insert_with(|| {
+                                let node = self
+                                    .nodes
+                                    .get(&destination)
+                                    .expect("stable destination disappeared");
+                                let TreeNode::Leaf(leaf) = node.value() else {
+                                    panic!("stable destination changed type");
+                                };
+                                let target_centroid = leaf.centroid.clone();
+                                let query = source_query.as_ref().map(|query| {
+                                    let residual: Vec<_> = target_centroid
+                                        .iter()
+                                        .zip(&centroid)
+                                        .map(|(a, b)| a - b)
+                                        .collect();
+                                    QuantizedQuery::new(
+                                        &residual,
+                                        self.padded_bytes(),
+                                        query.c_norm,
+                                        f32::dot(&centroid, &target_centroid).unwrap_or(0.0) as f32,
+                                        Self::vec_norm(&target_centroid),
+                                    )
+                                });
+                                PreparedTransfer {
+                                    centroid: target_centroid,
+                                    query,
+                                    ids: Vec::new(),
+                                    codes: Vec::new(),
+                                }
+                            });
+                            let eligible = forced
+                                || if self.config.fp_npa {
+                                    self.dist(&embedding, &target.centroid)
+                                        < self.dist(&embedding, &centroid)
+                                } else {
+                                    let code = Code::<1, _>::new(code);
+                                    code.distance_quantized_query(
+                                        &self.distance_fn,
+                                        target.query.as_ref().unwrap(),
+                                    ) < code.distance_quantized_query(
+                                        &self.distance_fn,
+                                        source_query.as_ref().unwrap(),
+                                    )
+                                };
+                            if eligible {
+                                target.ids.push(id);
+                                push_code(
+                                    &mut target.codes,
+                                    Code::<1>::quantize(&embedding, &target.centroid).as_ref(),
+                                );
+                                moved = true;
+                                accepted += 1;
+                            }
+                        }
+                    } else if forced {
+                        // An ordinary proposal may stay at its valid source.
+                        // Evacuation remains required ownership work.
+                        result.retries.push(Reassignment {
+                            source,
+                            ids: vec![id],
+                            excluded,
+                        });
+                    }
+                }
+            }
+            if !moved {
+                remaining.ids.push(id);
+                remaining.codes.extend_from_slice(code);
+            }
+        }
+        self.stats
+            .transfer_source_entries_scanned
+            .fetch_add(ids.len() as u64, Ordering::Relaxed);
+        if accepted > 0 {
+            result.remaining = Some(remaining);
+            result.outgoing = targets
+                .into_iter()
+                .filter_map(|(id, target)| {
+                    (!target.ids.is_empty()).then_some((
+                        id,
+                        PostingRows {
+                            ids: target.ids,
+                            codes: target.codes,
+                        },
+                    ))
+                })
+                .collect();
+        }
+        self.stats
+            .reassign_nanos
+            .fetch_add(start.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        result
+    }
+
     /// Route all candidates first, then compact the source once across targets.
     /// Contention and removed destinations remain explicit work for later rounds.
     fn reassign_many(&self, source: NodeId, ids: &[u32], excluded: Option<NodeId>) {
+        if self.defer_transfers.load(Ordering::Acquire) {
+            self.pending_transfers.lock().push(Reassignment {
+                source,
+                ids: ids.to_vec(),
+                excluded,
+            });
+            return;
+        }
         if !matches!(self.nodes.get(&source).as_deref(), Some(TreeNode::Leaf(_))) {
             return;
         }
@@ -2355,6 +2734,24 @@ impl HierarchicalSpannWriter {
             }
             leaf.centroid.clone()
