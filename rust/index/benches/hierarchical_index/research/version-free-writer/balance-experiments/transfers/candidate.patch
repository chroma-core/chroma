+    #[test]
+    fn joined_batch_combines_outgoing_and_incoming_without_losing_cycle_rows() {
+        for fp_npa in [false, true] {
+            for threads in [1, 4] {
+                let (mut writer, a, b) = three_leaves();
+                writer.config.fp_npa = fp_npa;
+                writer.transfer_group(0, a, &[7], true);
+                writer.transfer_group(0, b, &[8], true);
+                set_leaf_centroid(&writer, a, 2.0);
+                set_leaf_centroid(&writer, b, 0.0);
+                writer.refresh_navigation();
+                let mut timing = BalanceIterationTiming::default();
+                writer.apply_transfer_batch(
+                    vec![queue_move(a, &[7, 7], false), queue_move(b, &[8], false)],
+                    threads,
+                    &mut timing,
+                );
+                assert_codes_and_ids(&writer, &[7, 8, 9]);
+                assert!(
+                    matches!(writer.nodes.get(&a).as_deref(), Some(TreeNode::Leaf(leaf)) if leaf.ids == [8])
+                );
+                assert!(
+                    matches!(writer.nodes.get(&b).as_deref(), Some(TreeNode::Leaf(leaf)) if leaf.ids == [7])
+                );
+                assert_eq!(timing.retry_coalesced_ids, 2);
+                assert!(writer.pending_transfers.lock().is_empty());
+            }
+        }
+    }
+
+    #[test]
+    fn joined_batch_retains_a_sink_when_every_leaf_requests_evacuation() {
+        for leaves in [2, 3] {
+            let (writer, a, b) = three_leaves();
+            writer.transfer_group(0, a, &[7], true);
+            let mut pending = vec![queue_move(0, &[8, 9], true), queue_move(a, &[7], true)];
+            if leaves == 3 {
+                writer.transfer_group(0, b, &[8], true);
+                pending.push(queue_move(b, &[8], true));
+            } else {
+                writer.retire_empty_leaf(b);
+            }
+            writer.apply_transfer_batch(pending, 4, &mut BalanceIterationTiming::default());
+            assert_codes_and_ids(&writer, &[7, 8, 9]);
+            assert_eq!(
+                writer
