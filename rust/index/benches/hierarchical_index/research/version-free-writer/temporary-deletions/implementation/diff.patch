index 52b19342f..a2011a4dc 100644
--- a/rust/index/benches/hierarchical_index/common.rs
+++ b/rust/index/benches/hierarchical_index/common.rs
@@ -95,6 +95,65 @@ pub struct LeafNode {
     /// Total posting count. When `ids.len() < length`, these in-memory
     /// vectors contain only entries added since the persisted list was opened.
     pub length: usize,
+    /// Deleted physical slots exist only during writer balancing. Appending a
+    /// returned vector creates a new live slot; old copies stay deleted.
+    pub deleted_slots: Vec<u64>,
+    pub deleted_count: usize,
+}
+
+impl LeafNode {
+    pub fn live_len(&self) -> usize {
+        self.length - self.deleted_count
+    }
+
+    pub fn slot_is_live(&self, slot: usize) -> bool {
+        self.deleted_slots
+            .get(slot / 64)
+            .is_none_or(|word| word & (1 << (slot % 64)) == 0)
+    }
+
+    pub fn live_ids(&self) -> impl Iterator<Item = u32> + '_ {
+        self.ids
+            .iter()
+            .copied()
+            .enumerate()
+            .filter_map(|(slot, id)| self.slot_is_live(slot).then_some(id))
+    }
+
+    pub fn reserve_deleted_slots(&mut self) {
+        self.deleted_slots.resize(self.ids.len().div_ceil(64), 0);
+    }
+
+    pub fn delete_slot(&mut self, slot: usize) {
+        assert!(self.slot_is_live(slot));
+        self.deleted_slots[slot / 64] |= 1 << (slot % 64);
+        self.deleted_count += 1;
+    }
+
+    /// Move surviving IDs and codes together after workers join, or while a
+    /// source claim excludes all other mutations before a split.
+    pub fn compact_deleted_slots(&mut self, code_size: usize) {
+        if self.deleted_count == 0 {
+            return;
+        }
+        assert_eq!(self.ids.len(), self.length);
+        assert_eq!(self.codes.len(), self.length * code_size);
+        let mut write = 0;
+        for read in 0..self.ids.len() {
+            if self.slot_is_live(read) {
+                self.ids[write] = self.ids[read];
+                self.codes
+                    .copy_within(read * code_size..(read + 1) * code_size, write * code_size);
+                write += 1;
+            }
+        }
+        assert_eq!(write, self.live_len());
+        self.ids.truncate(write);
+        self.codes.truncate(write * code_size);
+        self.length = write;
+        self.deleted_count = 0;
+        self.deleted_slots = Vec::new();
+    }
 }
 
