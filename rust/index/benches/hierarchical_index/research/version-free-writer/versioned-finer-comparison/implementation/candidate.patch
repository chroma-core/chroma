+    fn assert_live_postings(writer: &HierarchicalSpannWriter, expected: &[u32]) {
+        let code_size = writer.code_size();
+        let mut stack = vec![writer.root_id()];
+        let mut seen_nodes = HashSet::new();
+        let mut live = HashSet::new();
+        while let Some(id) = stack.pop() {
+            assert!(seen_nodes.insert(id), "node has multiple reachable parents");
+            let node = writer.nodes.get(&id).expect("reachable node is present");
+            match node.value() {
+                TreeNode::Internal(internal) => {
+                    for child in internal.children() {
+                        let child_node = writer.nodes.get(child).unwrap();
+                        let parent = match child_node.value() {
+                            TreeNode::Leaf(leaf) => leaf.parent_id,
+                            TreeNode::Internal(internal) => internal.parent_id,
+                        };
+                        assert_eq!(parent, Some(id));
+                        stack.push(*child);
+                    }
+                }
+                TreeNode::Leaf(leaf) => {
+                    assert_eq!(leaf.length, leaf.ids.len());
+                    assert_eq!(leaf.versions.len(), leaf.ids.len());
+                    assert_eq!(leaf.codes.len(), leaf.ids.len() * code_size);
+                    for (offset, (&vector_id, &version)) in
+                        leaf.ids.iter().zip(&leaf.versions).enumerate()
+                    {
+                        if !writer.is_valid(vector_id, version) {
+                            continue;
+                        }
+                        assert!(live.insert(vector_id), "duplicate live vector {vector_id}");
+                        let embedding = writer.embeddings.get(&vector_id).unwrap();
+                        let code = Code::<1>::quantize(embedding.value(), &leaf.centroid);
+                        assert_eq!(
+                            &leaf.codes[offset * code_size..(offset + 1) * code_size],
+                            code.as_ref()
+                        );
+                    }
+                }
+            }
+        }
+        assert_eq!(seen_nodes.len(), writer.nodes.len(), "unreachable nodes");
+        assert_eq!(live, expected.iter().copied().collect());
+    }
