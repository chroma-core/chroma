+                    writer.versions.insert(1, 2);
+                    writer.dirty_versions.insert(1);
+                    2
+                }
+                "deleted" => {
+                    writer.add(1, &[2.0, 0.0, 0.0, 0.0]);
+                    writer.delete(1);
+                    2
+                }
