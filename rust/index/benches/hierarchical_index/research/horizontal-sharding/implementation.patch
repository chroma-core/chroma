+    root=Path(output);config=dict(dataset=DATASET,revision=REVISION,manifest_sha256=content_hash(manifest),count=count,children=children,epoch=epoch,source_id=source_id,metric=metric,chunk_rows=chunk_rows,sample_size=sample_size,seed=seed,iterations=iterations)
