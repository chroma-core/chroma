+            writer.add(0, &[1.0, 0.0, 0.0, 0.0]);
+            let reader = open(&writer, &p, config).await;
+            let children = if scenario == "repeated" {
+                vec![1, 1]
+            } else {
+                vec![1]
+            };
+            reader.nodes.insert(
+                reader.root_id,
+                TreeNode::Internal(InternalNode {
+                    centroid: Vec::new(),
+                    centroid_code: Vec::new(),
+                    children,
+                    parent_id: None,
+                }),
+            );
+            if scenario != "missing" {
+                reader.nodes.insert(
+                    1,
+                    TreeNode::Leaf(LeafNode {
+                        centroid: Vec::new(),
+                        centroid_code: Vec::new(),
+                        ids: Vec::new(),
+                        versions: Vec::new(),
+                        codes: Vec::new(),
+                        parent_id: if scenario == "parent" {
+                            None
+                        } else {
+                            Some(reader.root_id)
