+                        length: 0,
+                    }),
+                );
+            }
+            assert!(
+                reader
+                    .audit_reachable_ids(1, AuditLimits::default())
+                    .await
+                    .is_err(),
+                "scenario {scenario} must fail"
+            );
+            assert_eq!(reader.vector_data_reader.loaded_blocks_stats().0, 0);
+        }
+    }
+}
