+            model=json.loads((root/'chunked/model.json').read_text());self.assertGreater(max(model['sample_row_ids']),15)
+            self.assertEqual(len(model['sample_row_ids']),12)
+            mapped=[]
+            for sa,sb in zip(a['subtrees'],b['subtrees']):
