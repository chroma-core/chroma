+    expected_manifest = '1f2e544a0707d22e238963379e6dd18ab786d900f38ab3158bf21f228111c12f'
+    if receipt['binary_sha256'] != expected_binary or digest(receipt['binary']) != expected_binary:
+        raise ValueError('Retained binary mismatch')
