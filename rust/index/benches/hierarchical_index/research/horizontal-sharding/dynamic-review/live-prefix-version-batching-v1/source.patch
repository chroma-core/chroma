+                    if version==b.current(id).unwrap_or(0) && seen.insert(id) {if let Some(eligible)=predicate {count=1;if eligible {action=Some(0);}}}
+                    (1,count,action)
+                };
+                evaluations+=evaluated;
+                if let Some(slot)=action {
