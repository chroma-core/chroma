+                );
+            }
+            "eligible" => {
+                if e["eligible"] == true {
+                    let (owner, source) = sessions[&e["session"].as_u64().unwrap()];
+                    if owner != source {
+                        cross = true;
+                    }
+                }
+            }
+            "registered" => {
+                if e["id"] == 5 {
+                    registration = Some((position, e["current"].as_u64().unwrap()));
+                }
+            }
+            "before_scrub" => {
+                if let Some((prior, current)) = registration {
