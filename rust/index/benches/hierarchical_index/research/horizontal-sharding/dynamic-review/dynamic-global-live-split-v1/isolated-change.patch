+                        if let Some(rows) = e["versions"].as_array() {
+                            for row in rows {
+                                if row[0] == 5
+                                    && row[2].as_u64() == Some(current)
+                                    && row[1].as_u64() != Some(current)
+                                {
+                                    later_visibility = true;
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+            _ => {}
+        }
