+impl Drop for CriticalSpan {
+    fn drop(&mut self) {
+        CRITICAL_DEPTH.with(|v| {
+            let mut v = v.borrow_mut();
+            let d = v.get_mut(&self.key).expect("critical depth missing");
+            *d -= 1;
+            if *d == 0 {
