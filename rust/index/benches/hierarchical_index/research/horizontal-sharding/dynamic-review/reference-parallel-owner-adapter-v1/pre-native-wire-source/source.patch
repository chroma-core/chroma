+        leaf: u32,
+        values: Arc<[f32]>,
+        predicate: Arc<Predicate>,
+    ) -> bool {
+        let owner = *self.leaf_owner.get(&leaf).expect("predicate owner missing");
+        self.predicate_calls.fetch_add(1, Ordering::Relaxed);
+        self.actor(owner).call(move |_s| {
