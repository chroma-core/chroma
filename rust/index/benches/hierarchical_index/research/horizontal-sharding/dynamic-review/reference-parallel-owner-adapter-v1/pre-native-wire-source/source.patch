+        self.predicate_calls.fetch_add(1, Ordering::Relaxed);
+        self.actor(owner).call(move |_s| {
+            super::eligibility::fp_eligible(
+                &predicate.metric,
+                &values,
+                &predicate.centroid,
+                &predicate.old,
+                &predicate.left,
+                &predicate.right,
+            )
