+    /// Consecutive owner runs preserve the first failing location/current check.
+    /// Reads are serialized; no mutation occurs between these validation calls.
+    pub(super) fn validate_trace_reference_runs(&mut self, rows:&[(u32,u8)]) -> Result<()> {
+        let mut start=0;
+        while start<rows.len() {
+            let owner=self.locations.get(&rows[start].0).context("current location missing")?.0;
+            self.owner(owner)?;
+            let mut end=start+1;
+            while end<rows.len() {
+                match self.locations.get(&rows[end].0) {
+                    Some(&(next,_)) if next==owner => end+=1,
+                    _ => break,
+                }
+            }
+            let ids=rows[start..end].iter().map(|r|r.0).collect();
+            if let Some(v)=self.before_scrub_attribution.as_mut() {v.batch_validation_calls+=1;}
+            ensure!(matches!(self.structural(owner,OwnerCommand::ValidateReferences(ids))?,OwnerReply::Ack),"reference batch reply");
+            if let Some(v)=self.before_scrub_attribution.as_mut() {v.batch_validation_successes+=1;v.batch_validated_rows+=(end-start) as u64;}
+            start=end;
         }
         Ok(())
     }
