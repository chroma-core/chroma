+#[tokio::test]
+async fn authoritative_owner_rejects_unsupported_navigation_before_storage_and_checks_budget() {
+    use super::super::config::NavigationMode;
+    use super::authoritative_owner::checked_physical_budget;
+    let dir = tempfile::tempdir().unwrap();
+    let mut config = HierarchicalSpannConfig::default();
+    config.write_navigation = NavigationMode::FourBit;
+    let ids = super::HierarchicalSpannIds {
+        posting_list_id: uuid::Uuid::nil(),
+        scalar_metadata_id: uuid::Uuid::nil(),
+        vector_data_id: uuid::Uuid::nil(),
+        leaf_node_id: uuid::Uuid::nil(),
+        internal_node_id: uuid::Uuid::nil(),
+    };
+    let error = AuthoritativeTree::open(
+        provider(dir.path()),
+        ids,
+        DistanceFunction::Euclidean,
+        config,
+        1,
+        1,
+    )
+    .await
+    .err()
+    .expect("unsupported navigation must reject");
+    assert_eq!(error.to_string(), "FP-only authority routing");
+    assert_eq!(std::fs::read_dir(dir.path()).unwrap().count(), 0);
+    checked_physical_budget(255, 1).unwrap();
+    checked_physical_budget(256, 0).unwrap();
+    assert!(checked_physical_budget(256, 1).is_err());
+    assert!(checked_physical_budget(usize::MAX, 1).is_err());
+}
