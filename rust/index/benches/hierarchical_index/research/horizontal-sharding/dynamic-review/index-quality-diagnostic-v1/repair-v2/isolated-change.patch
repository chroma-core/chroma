+                        .sum::<f64>(),
+                )
+            })
+            .collect();
+        rows.sort_by(|a, b| a.1.total_cmp(&b.1).then(a.0.cmp(&b.0)));
+        rows.truncate(k);
+        rows.into_iter().unzip()
+    }
