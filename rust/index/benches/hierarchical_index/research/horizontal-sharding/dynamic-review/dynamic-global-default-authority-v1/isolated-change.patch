+    let initial = HierarchicalSpannWriter::new(32, DistanceFunction::Euclidean, scaled());
+    initial.add(0, &rows[0]);
+    let old = initial
+        .commit(&p, None)
+        .await
+        .unwrap()
+        .flush()
+        .await
+        .unwrap();
+    drop(initial);
