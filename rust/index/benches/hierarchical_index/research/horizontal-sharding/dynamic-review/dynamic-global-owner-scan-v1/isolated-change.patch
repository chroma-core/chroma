+                    ids: node.ids.clone(),
+                    versions: node.versions.clone(),
+                    codes: node.codes.clone(),
+                    current: node
+                        .ids
+                        .iter()
+                        .map(|&id| self.reference.current_version_sync(id))
+                        .collect(),
+                    vectors,
+                });
+        }
+        Ok(sources)
+    }
