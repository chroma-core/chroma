+                fleet.request(owner, leaf, old, left, right, c.fp_npa, &evaluated)?;
+            for &id in &reply.inserted_evaluated {
+                ensure!(
+                    evaluated.insert(id),
+                    "owner returned duplicate evaluated ID"
