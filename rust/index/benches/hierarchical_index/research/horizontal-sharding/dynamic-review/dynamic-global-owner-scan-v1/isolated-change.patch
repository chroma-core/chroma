+    pub fn scan_global_neighbors(
+        &self,
+        old_leaf: NodeId,
+        left_leaf: NodeId,
+        right_leaf: NodeId,
+        old: &[f32],
+        left: &[f32],
+        right: &[f32],
+    ) -> Result<NeighborScanReport> {
