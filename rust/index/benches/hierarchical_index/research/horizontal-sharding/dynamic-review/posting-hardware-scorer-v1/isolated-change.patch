+                let mut unaligned=vec![0x55];unaligned.extend_from_slice(&bytes);let mut shifted=Vec::new();scorer.for_each_integer_sum(&unaligned[1..],&q,|_,sum|shifted.push(sum)).unwrap();assert_eq!(shifted,expected);
