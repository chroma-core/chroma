+            assert_eq!(
+                m.request_current(id(3), req(vec![3])),
+                Err(ProtocolError::Conflict)
+            );
+            if expected == ReservationStatus::Granted {
+                m.release(id(3)).unwrap();
+            }
+        }
+    }
 }
